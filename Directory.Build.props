<Project>
  <!-- Wird von allen Projekten automatisch geladen. Rechnerspezifische Pfade (z. B. GameDir) stehen in
       LocalPaths.props, die nicht im Repository liegt. Vorlage: LocalPaths.props.example -->
  <Import Project="$(MSBuildThisFileDirectory)LocalPaths.props" Condition="Exists('$(MSBuildThisFileDirectory)LocalPaths.props')" />
</Project>
